# Evaluation settings for Ultimate Tic-Tac-Toe (ADR 0012 to 0015, 0020, 0038, 0042, 0048, 0049),
# read by scripts/sprt.sh and scripts/league.sh. One KEY=value per line, no
# quotes, a value may be empty; an environment variable with the same name
# overrides the value here (an empty one does not).

# Arena. Time limits are multiplied by TIME_SCALE (bots read the factor from
# CG_TIME_SCALE), then TIME_TOLERANCE_MS is added without telling the bots.
# Every strength evaluation (smoke test, SPRT, league, local screening) plays
# at CodinGame's speed and real limit, calibrated on each machine (ADR 0048,
# decisions 1 to 3, which ADR 0049 decision 8 applies to this game): with
# both `auto`, scripts/sprt.sh and scripts/league.sh first run the
# CALIBRATION_BOT's workload as many times at once as the games they play,
# then set TIME_SCALE = CG_SPEED / the machine's speed and TIME_TOLERANCE_MS
# = CG_EXTRA_MS x TIME_SCALE, rounded. For a local screening, take the values
# from `scripts/calibrate.sh uttt`. CodinGame gives this game 100 ms per turn
# and 1,000 ms for the first. A number given in the environment replaces
# `auto` (both must then be numbers), for a look at other limits.
# OPENING_PLIES random moves start each pair of games.
TIME_SCALE=auto
TIME_TOLERANCE_MS=auto

# The calibration (ADR 0048): the bot whose workload measures a machine, its
# speed on CodinGame in the workload's search iterations a millisecond, and
# the milliseconds CodinGame allows beyond its stated 100, by a bot's clock.
# Both from 12 test games of the timing bot against itself through the API on
# 2026-11-05 (916992872, 916993089, 916993151, 916993220, 916993289,
# 916993348, 916993484, 916993610, 916993721, 916993854, 916993941,
# 916994116): its workload ran a median of 296 iterations a millisecond over
# 461 timed stretches (the games' medians 256 to 377), and the games were cut
# at 112 to 116 ms, answers held to 111 ms being accepted in every game.
# Change them only with new games of the timing bot on CodinGame, cited in
# the pull request.
CALIBRATION_BOT=timing
CG_SPEED=296
CG_EXTRA_MS=12

# Time limits of the smoke test, the SPRT and the league, when they differ
# from the arena's above (ADR 0020). Empty: they follow TIME_SCALE and
# TIME_TOLERANCE_MS, as ADR 0042 requires.
SPRT_TIME_SCALE=
SPRT_TIME_TOLERANCE_MS=
OPENING_PLIES=4
SEED=1

# Share of its games the candidate may lose on time in each stage (smoke
# test, SPRT, confirmation), rounded down; a timeout still loses its game.
# Crashes and invalid answers always fail. ADR 0015.
MAX_TIMEOUT_RATE=0.01

# SPRT of a candidate against its baseline.
SPRT_ELO0=0
SPRT_ELO1=10
SPRT_ALPHA=0.05
SPRT_BETA=0.05
# About 3.8 hours on one runner at CodinGame's exact limits (ADR 0020); over
# SPRT_RUNNERS runners, about an eighth of that times each runner's time scale.
SPRT_MAX_PAIRS=8000

# The SPRT over runners (ADR 0049, decisions 1 and 8): SPRT_RUNNERS
# calibrated runners each play blocks of SPRT_BLOCK_PAIRS pairs, and the
# bounds are checked after each round of blocks; ice-and-fire's
# evaluation.env explains the choice of 10.
SPRT_RUNNERS=8
SPRT_BLOCK_PAIRS=10

# Confirmation of an accepted candidate at CodinGame's time limits:
# pairs against the baseline. It fails if the candidate is clearly weaker
# there (the 95% interval of its Elo advantage below 0), crashes, answers
# invalidly, or loses more than MAX_TIMEOUT_RATE of its games on time.
# 0 skips it, as here: the SPRT already plays at CodinGame's speed and real
# limit (ADR 0048).
CONFIRM_PAIRS=0

# Smoke test before the SPRT: the candidate against the random bot.
SMOKE_PAIRS=100
SMOKE_MIN_SCORE=0.99

# Baseline until the first release exists: a bot of games/uttt/bots.
BASELINE_BOT=greedy

# League (ADR 0038): each new release plays its previous release, the fixed
# opponents and the LEAGUE_NEAREST bots nearest in rating, LEAGUE_PAIRS pairs
# each (800: 1,600 games, about +-17 Elo at 95% near 50%, ADR 0042; about
# 3.5 hours a release), at the SPRT's time limits; results in league.jsonl,
# LEADERBOARD.md generated from them. LEAGUE_CANARY is a stored pairing
# replayed on each run (A,B), empty until the bootstrap has chosen one.
LEAGUE_BOTS=random,greedy
# The bot at 0 Elo: the first release (ADR 0050); random until v001's league results are in league.jsonl.
LEAGUE_ANCHOR=v001
LEAGUE_PAIRS=800
LEAGUE_FIXED=greedy,v001
LEAGUE_NEAREST=5
# Chosen 2026-10-17 once the bootstrap was done: of the stored pairings
# between two releases, the one whose score is nearest 50% (v009 against
# v008: 50.5% over 100 pairs).
LEAGUE_CANARY=v009,v008

# Nightly league (ADR 0049, 0050; .github/workflows/league-nightly.yml,
# scripts/league-night.sh). false: Ultimate Tic-Tac-Toe keeps its league on
# the release's pull request until its stored history has been replayed at
# the calibrated settings (ADR 0048 decision 5, ADR 0049 decision 8). A
# release's league before then plays calibrated, beside lines played at scale
# 1 (the leaderboard marks such a file mixed); the replay plays every stored
# pairing again, those included, so the file then holds calibrated results
# only. The other settings are ready for then.
# The night's runners and its whole budget of time in minutes (6 runners and
# 3 hours for each game, ADR 0050 decision 3); the pairs the planner may
# spend, which is only an upper bound since play stops at its deadline; the
# half-width in Elo the top LEAGUE_TOP bots' 95% intervals should reach,
# measured from LEAGUE_ANCHOR (ADR 0050 decision 2); the pairs of one step of
# the precision share (200: 400 games); and the share of what the new bots
# leave that goes to the other bots (ADR 0049 decision 4.3).
LEAGUE_NIGHTLY=false
LEAGUE_NIGHTLY_RUNNERS=6
LEAGUE_NIGHTLY_MINUTES=180
LEAGUE_NIGHTLY_PAIRS=30000
LEAGUE_TARGET_MARGIN=10
LEAGUE_TOP=10
LEAGUE_BLOCK_PAIRS=200
LEAGUE_LOW_SHARE=0.2
