# Evaluation settings for Ultimate Tic-Tac-Toe (ADR 0012 to 0015, 0020), read by
# scripts/sprt.sh and scripts/league.sh. One KEY=value per line, no quotes;
# an environment variable with the same name overrides the value here.

# Arena. Time limits are multiplied by TIME_SCALE (bots read the factor from
# CG_TIME_SCALE), then TIME_TOLERANCE_MS is added without telling the bots,
# to absorb the delays of a busy machine. OPENING_PLIES random moves start
# each pair of games.
TIME_SCALE=0.2
TIME_TOLERANCE_MS=5

# Time limits of the smoke test and the SPRT, when they differ from the
# arena's above (ADR 0020): the bot is in Legend, so CodinGame's exact
# limits. The league keeps TIME_SCALE.
SPRT_TIME_SCALE=1
SPRT_TIME_TOLERANCE_MS=0
OPENING_PLIES=4
SEED=1

# Share of its games the candidate may lose on time in each stage (smoke
# test, SPRT, confirmation), rounded down; a timeout still loses its game.
# Crashes and invalid answers always fail. ADR 0015.
MAX_TIMEOUT_RATE=0.01

# SPRT of a candidate against its baseline.
SPRT_ELO0=0
SPRT_ELO1=10
SPRT_ALPHA=0.05
SPRT_BETA=0.05
# About 3.8 hours at full time, within the job's 6-hour limit (ADR 0020).
SPRT_MAX_PAIRS=8000

# Confirmation of an accepted candidate at CodinGame's exact time limits:
# pairs against the baseline. It fails if the candidate is clearly weaker
# there (the 95% interval of its Elo advantage below 0), crashes, answers
# invalidly, or loses more than MAX_TIMEOUT_RATE of its games on time.
# 0 skips it, as here: the SPRT already plays at those limits (ADR 0020).
CONFIRM_PAIRS=0

# Smoke test before the SPRT: the candidate against the random bot.
SMOKE_PAIRS=100
SMOKE_MIN_SCORE=0.99

# Baseline until the first release exists: a bot of games/uttt/bots.
BASELINE_BOT=greedy

# League: every release plus these bots of games/uttt/bots.
LEAGUE_BOTS=random,greedy
LEAGUE_ANCHOR=random
LEAGUE_PAIRS=100
