# Evaluation settings for A Code of Ice and Fire (ADR 0012 to 0015, 0020, 0038, 0042),
# read by scripts/sprt.sh and scripts/league.sh. One KEY=value per line, no
# quotes, a value may be empty; an environment variable with the same name
# overrides the value here (an empty one does not).

# Arena. Time limits are multiplied by TIME_SCALE (bots read the factor from
# CG_TIME_SCALE), then TIME_TOLERANCE_MS is added without telling the bots.
# Every strength evaluation (smoke test, SPRT, league, local screening) plays
# at CodinGame's speed and real limit, calibrated on each machine (ADR 0048):
# with both `auto`, scripts/sprt.sh and scripts/league.sh first run the
# CALIBRATION_BOT's workload as many times at once as the games they play,
# then set TIME_SCALE = CG_SPEED / the machine's speed and TIME_TOLERANCE_MS
# = CG_EXTRA_MS x TIME_SCALE, rounded. For a local screening, take the values
# from `scripts/calibrate.sh ice-and-fire`. CodinGame gives this game 50 ms
# per turn and 1,000 ms for the first. A number given in the environment
# replaces `auto` (both must then be numbers), for a look at other limits.
TIME_SCALE=auto
TIME_TOLERANCE_MS=auto

# The calibration (ADR 0048): the bot whose workload measures a machine, its
# speed on CodinGame in units a millisecond, and the milliseconds CodinGame
# allows beyond its stated 50, by a bot's clock. Both from the timing bot's
# self-play games in the CodinGame IDE on 2026-10-31 (E031): its workload ran
# 10.6 to 11.6 units a millisecond, and answers held to 62 and 64 ms were
# accepted, the games being cut at 63, 64 and 65 ms. Change them only with
# new games of the timing bot on CodinGame, cited in the pull request.
CALIBRATION_BOT=timing
CG_SPEED=11
CG_EXTRA_MS=13

# Time limits of the smoke test, the SPRT and the league, when they differ
# from the arena's above (ADR 0020). Empty: they follow TIME_SCALE and
# TIME_TOLERANCE_MS, as ADR 0042 requires.
SPRT_TIME_SCALE=
SPRT_TIME_TOLERANCE_MS=

# The referee ignores OPENING_PLIES: each seed's map already varies the
# games, and a pair plays one seed from both seats (ADR 0039). 0 is the value
# that says so; no opening is imposed.
OPENING_PLIES=0
SEED=1

# Share of its games the candidate may lose on time in each stage (smoke
# test, SPRT, confirmation), rounded down; a timeout still loses its game.
# Crashes and invalid answers always fail. ADR 0015.
MAX_TIMEOUT_RATE=0.01

# SPRT of a candidate against its baseline. As uttt's: the game's numbers
# (README.md: no draws in 3,000 games, a seat advantage that the seat-swapped
# pairs cancel) give no reason to change them.
SPRT_ELO0=0
SPRT_ELO1=10
SPRT_ALPHA=0.05
SPRT_BETA=0.05
# At full time a bot that uses 40 ms of every 50 ms answer plays a game of
# 141 answers (random players' mean, README.md, "Numbers"; Bronze bots' are
# about 30) in 5.6 s, and the 16,000 games of 8,000 pairs, 4 at a time, take
# about 6.3 hours: past sprt.yml's 360-minute job limit, which fits games
# that average 5.4 s (about 130 answers, or 85 if each bot also uses 1,000 ms
# on its first answer). A test stops as soon as it is confident, long before
# the cap unless two bots are close. Check the cap against the first search
# bot's game length (ADR 0042).
SPRT_MAX_PAIRS=8000

# The SPRT over runners (ADR 0049, decision 1; .github/workflows/sprt-parallel.yml).
# SPRT_RUNNERS runners (1: the SPRT of sprt.yml's own job, on one machine) each
# play a tournament of their own seed in blocks of SPRT_BLOCK_PAIRS seat-swapped
# pairs; the bounds are checked after each round, which is one block from every
# runner, 8 x 10 = 80 pairs. More than one runner needs TIME_SCALE=auto: runners
# differ in speed, and each is calibrated (ADR 0048). 8,000 pairs over 8
# runners in blocks of 10 are 100 blocks a runner.
# SPRT_BLOCK_PAIRS comes from the simulation of the arena's SPRT checked after
# every pair against checks every 8 x B pairs (crates/cg-arena/src/sprt/tests.rs,
# choose_the_block_size: 40,000 tests at each strength, draws about 10%, elo0 0,
# elo1 10, alpha = beta = 0.05, cap 8,000 pairs, the same pair results given to
# every rule). False accept (Elo 0), false reject (Elo 10), and the mean pairs
# played at Elo 0 / 5 / 10, with the change against checking after every pair:
#                false accept  false reject  mean pairs at Elo 0 / 5 / 10
#   every pair       4.71%         4.89%       2830 / 4157 / 2832
#   B = 10           3.87%         4.03%       3074 (+8.6%) / 4546 (+9.4%) / 3076 (+8.6%)
#   B = 25           3.34%         3.48%       3248 (+14.8%) / 4795 (+15.3%) / 3254 (+14.9%)
#   B = 50           2.86%         2.99%       3459 (+22.2%) / 5073 (+22.0%) / 3464 (+22.3%)
# Checking less often lowered both error rates in the simulation (ADR 0049
# expects it); what it costs is pairs, and the share left undecided at the cap (3.0% every pair, 4.0% at
# B = 10, 4.7% at B = 25, 5.4% at B = 50 at Elo 0). B = 10 is the largest size
# whose mean pairs stay within 10% of checking after every pair.
SPRT_RUNNERS=8
SPRT_BLOCK_PAIRS=10

# Confirmation of an accepted candidate at CodinGame's exact time limits
# (ADR 0014): pairs against the baseline. 0 skips it, as here: the SPRT
# already plays at those limits (ADR 0042).
CONFIRM_PAIRS=0

# Smoke test before the SPRT: the candidate against the random bot. Even the
# greedy bronze bot wins every game against it, so a candidate that loses more
# than 2 of 200 has a bug.
SMOKE_PAIRS=100
SMOKE_MIN_SCORE=0.99

# Baseline until the first release exists: a bot of games/ice-and-fire/bots.
# bronze is our best bot (the greedy policy with all the rules).
BASELINE_BOT=bronze

# League (ADR 0038): each new release plays its previous release, the fixed
# opponents and the LEAGUE_NEAREST bots nearest in rating, LEAGUE_PAIRS pairs
# each (800: 1,600 games, about +-17 Elo at 95% near 50%, ADR 0042), at the
# SPRT's time limits; results in league.jsonl, LEADERBOARD.md generated from
# them. LEAGUE_CANARY is a stored pairing replayed on each run
# (A,B), empty until the bootstrap has chosen one. The first release,
# ice-and-fire-v001, is the banker bot, the last step of E001's ladder of
# reference bots, so banker is not listed; chain, guard and cutter, its first
# steps, are. The fixed opponent stays bronze, the baseline of v001.
LEAGUE_BOTS=random,bronze,chain,guard,cutter
# The bot at 0 Elo: the first release (ADR 0050); random until v001's league results are in league.jsonl.
LEAGUE_ANCHOR=v001
LEAGUE_PAIRS=800
LEAGUE_FIXED=bronze
LEAGUE_NEAREST=5
LEAGUE_CANARY=

# Nightly league (ADR 0049, 0050; .github/workflows/league-nightly.yml,
# scripts/league-night.sh). true: the league runs every night, and a
# release's pull request plays none.
# The night's runners and its whole budget of time in minutes (6 runners and
# 3 hours for each game, ADR 0050 decision 3); the pairs the planner may
# spend, which is only an upper bound since play stops at its deadline; the
# half-width in Elo the top LEAGUE_TOP bots' 95% intervals should reach,
# measured from LEAGUE_ANCHOR (ADR 0050 decision 2); the pairs of one step of
# the precision share (200: 400 games); and the share of what the new bots
# leave that goes to the other bots (ADR 0049 decision 4.3).
LEAGUE_NIGHTLY=true
LEAGUE_NIGHTLY_RUNNERS=6
LEAGUE_NIGHTLY_MINUTES=180
LEAGUE_NIGHTLY_PAIRS=30000
LEAGUE_TARGET_MARGIN=10
LEAGUE_TOP=10
LEAGUE_BLOCK_PAIRS=200
LEAGUE_LOW_SHARE=0.2
