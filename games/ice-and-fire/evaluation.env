# Evaluation settings for A Code of Ice and Fire (ADR 0012 to 0015, 0020, 0038),
# read by scripts/sprt.sh and scripts/league.sh. One KEY=value per line, no
# quotes, a value may be empty; an environment variable with the same name
# overrides the value here (an empty one does not).

# Arena. Time limits are multiplied by TIME_SCALE (bots read the factor from
# CG_TIME_SCALE), then TIME_TOLERANCE_MS is added without telling the bots,
# to absorb the delays of a busy machine. ADR 0013 (decision 1) keeps
# evaluations at "a time scale of 0.2" plus 5 ms of tolerance. CodinGame gives
# this game 50 ms per turn (1,000 ms for the first), so 0.2 is 10 ms here
# (uttt's 100 ms make 20 ms), then 15 ms with the tolerance (205 ms for the
# first answer). The owner chose it on 2026-10-17 ("0.2: 10 ms, as ADR 0013").
# The game has no bot in Legend yet (ADR 0020 asks for full time there).
TIME_SCALE=0.2
TIME_TOLERANCE_MS=5

# Time limits of the smoke test, the SPRT and the league, when they differ
# from the arena's above (ADR 0020, 0038). Empty: no bot of this game is in
# Legend, so they follow TIME_SCALE and TIME_TOLERANCE_MS. When one is, set
# 1 and 0 (CodinGame's exact limits), as games/uttt/evaluation.env does.
SPRT_TIME_SCALE=
SPRT_TIME_TOLERANCE_MS=

# The referee ignores OPENING_PLIES: each seed's map already varies the
# games, and a pair plays one seed from both seats (ADR 0039). 0 is the value
# that says so; no opening is imposed.
OPENING_PLIES=0
SEED=1

# Share of its games the candidate may lose on time in each stage (smoke
# test, SPRT, confirmation), rounded down; a timeout still loses its game.
# Crashes and invalid answers always fail. ADR 0015.
MAX_TIMEOUT_RATE=0.01

# SPRT of a candidate against its baseline. As uttt's: the game's numbers
# (README.md: no draws in 3,000 games, a seat advantage that the seat-swapped
# pairs cancel) give no reason to change them.
SPRT_ELO0=0
SPRT_ELO1=10
SPRT_ALPHA=0.05
SPRT_BETA=0.05
# A game is about 141.0 answers long (README.md, "Numbers"), so a bot that
# used 10 ms of every answer would take about 1.4 s a game and the 8,000 pairs
# about 1.6 hours on 4 jobs. The worst case, 200 answers of 15 ms plus two
# first answers of 205 ms, is 3.4 s a game and 8,000 pairs take about 3.8
# hours, then the confirmation (500 pairs) about 50 minutes more at the very
# worst: within sprt.yml's 360-minute job limit.
SPRT_MAX_PAIRS=8000

# Confirmation of an accepted candidate at CodinGame's exact time limits
# (ADR 0014): 500 pairs against the baseline, since the SPRT plays at 10 ms.
# It fails if the candidate is clearly weaker there (the 95% interval of its
# Elo advantage below 0), crashes, answers invalidly, or loses more than
# MAX_TIMEOUT_RATE of its games on time. Set 0 when the SPRT plays at full time.
CONFIRM_PAIRS=500

# Smoke test before the SPRT: the candidate against the random bot. Even the
# greedy bronze bot wins every game against it, so a candidate that loses more
# than 2 of 200 has a bug.
SMOKE_PAIRS=100
SMOKE_MIN_SCORE=0.99

# Baseline until the first release exists: a bot of games/ice-and-fire/bots.
# bronze is our best bot (the greedy policy with all the rules).
BASELINE_BOT=bronze

# League (ADR 0038): each new release plays its previous release, the fixed
# opponents and the LEAGUE_NEAREST bots nearest in rating, LEAGUE_PAIRS pairs
# each, at the SPRT's time limits; results in league.jsonl, LEADERBOARD.md
# generated from them. LEAGUE_CANARY is a stored pairing replayed on each run
# (A,B), empty until the bootstrap has chosen one. No release exists yet, so
# the only fixed opponent is bronze. chain, guard and cutter are the first
# steps of E001's ladder of reference bots (banker, the last step, is the
# release ice-and-fire-v001, so it is not listed).
LEAGUE_BOTS=random,bronze,chain,guard,cutter
LEAGUE_ANCHOR=random
LEAGUE_PAIRS=100
LEAGUE_FIXED=bronze
LEAGUE_NEAREST=5
LEAGUE_CANARY=
